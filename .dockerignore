# Ignore these in build context to reduce build time
.git
.gitignore
.env.local
.env*.local
.env
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.md
!init-scripts/README.md
!README_DOCKER.md
docker-compose*.yml
Dockerfile*
.dockerignore

# Build artifacts (will be created during build)
.next
node_modules
dist
build
out

# Development files
.vscode
.idea
*.swp
*.swo
*~

# Test files
**/__tests__/**
**/*.test.*
**/*.spec.*
coverage
.nyc_output

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug.log

# Misc
.cache
.temp
tmp
temp

# Large directories that don't need to be in build context
# Uploads should be handled via volume mounts, not in image
public/uploads/**
public/icons/**
migrations
scripts
docs
*.sql
*.db
*.sqlite
init-database.sql

# Docker files (except entrypoint)
docker-compose*.yml
Dockerfile*
.dockerignore

# Large data files that don't need to be in image
src/data/**
!src/data/capitals.json
!src/data/cities_name.json
!src/data/cities.json
!src/data/countries_main_coordinates.json
!src/data/countries_name.json
!src/data/countries.json
!src/data/states_name.json
!src/data/states.json

# Don't ignore docker-entrypoint.sh (needed for runtime)
!docker-entrypoint.sh
